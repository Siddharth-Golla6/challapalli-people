# Copy to .env and fill in as needed.

# Base URL of the backend API (see server/). Defaults to http://localhost:4000/api
# if unset.
VITE_API_URL=http://localhost:4000/api

# Dev-only: skip the backend entirely and serve in-memory sample data from
# src/data/mockApi.js. Lets you browse the full site with just `npm run dev`
# and no Supabase / R2 setup. Set to the string "true" to turn it on.
# A small banner at the bottom-right shows demo credentials when active.
# Leave unset or empty for production builds.
VITE_USE_MOCK=

# GPS location pickers use Leaflet + OpenStreetMap (free, no API key required).
