# Copy to .env and fill in before running the server.

# Supabase Postgres. Create a free project at supabase.com, then Connect →
# "Direct connection" tab to get these two URIs:
#   DATABASE_URL — Transaction pooler (port 6543), used by the running app.
#     Must include ?pgbouncer=true — Supabase's transaction-mode pooler
#     doesn't support prepared statements, which Prisma uses by default.
#   DIRECT_URL   — Session/direct connection (port 5432), used only by
#     Prisma's CLI (db push / migrate) — the pooler doesn't support the DDL
#     these need.
# If your DB password contains special characters (@, :, /, etc.), percent-
# encode them (@ → %40) or the connection string won't parse correctly.
DATABASE_URL=postgresql://postgres.xxxxxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxxxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's dev/prod URL).
CORS_ORIGIN=http://localhost:5174

# SMS (OTP + notifications) — see server/src/services/sms.js
# "mock" logs messages instead of sending (safe default for dev/staging).
# "live" sends through MSG91 and requires everything below to be filled in.
MSG91_PROVIDER_MODE=mock
MSG91_API_KEY=
MSG91_SENDER_ID=MNDVSM

# DLT-approved template IDs from MSG91, one per message type per language.
# Only required when MSG91_PROVIDER_MODE=live.
MSG91_TEMPLATE_ID_OTP_EN=
MSG91_TEMPLATE_ID_OTP_TE=
MSG91_TEMPLATE_ID_STATUSCHANGE_EN=
MSG91_TEMPLATE_ID_STATUSCHANGE_TE=
MSG91_TEMPLATE_ID_ASSIGNMENT_EN=
MSG91_TEMPLATE_ID_ASSIGNMENT_TE=
MSG91_TEMPLATE_ID_ANNOUNCEMENT_EN=
MSG91_TEMPLATE_ID_ANNOUNCEMENT_TE=

# Cloudflare R2 (problem photo storage) — see server/src/services/storage.js.
# All five are required; reporting a problem with photos fails without them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL your bucket serves from — either the r2.dev subdomain
# Cloudflare gives you, or a custom domain you've connected to the bucket.
R2_PUBLIC_URL=
