# Netlify production build picks up this file during `npm run build`.
# Keep real secrets OUT of this file (it's in git); use Netlify's
# Environment UI for anything sensitive.
#
# Flip VITE_USE_MOCK to `false` and point VITE_API_URL at your deployed
# backend (e.g. https://challapalli-people-api.onrender.com/api) once the
# backend is live. Until then this file leaves mock mode ON so the demo
# site still works standalone.
VITE_USE_MOCK=true
VITE_API_URL=https://challapalli-people-api.onrender.com/api
